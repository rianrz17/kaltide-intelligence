# =========================================
# KALTIDE Intelligence - Contoh Konfigurasi
# Salin file ini menjadi .env lalu sesuaikan
# =========================================

# --- Database ---
POSTGRES_USER=kaltide
POSTGRES_PASSWORD=ubah_password_ini
POSTGRES_DB=kaltide
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kaltide:ubah_password_ini@localhost:5432/kaltide

# --- BMKG API ---
BMKG_API_BASE_URL=https://api.bmkg.go.id
BMKG_API_KEY=

# --- PUSHIDROSAL / Tide Gauge ---
TIDE_API_BASE_URL=
TIDE_API_KEY=

# --- Notifikasi ---
WHATSAPP_GATEWAY_URL=
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Aplikasi ---
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=ubah_dengan_kunci_rahasia_acak
CORS_ORIGINS=http://localhost:3000

# --- Wilayah MVP (bounding box, format: min_lon,min_lat,max_lon,max_lat) ---
MVP_BBOX=116.6,-1.35,117.3,-0.4
